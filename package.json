{
  "name": "pi-dreamer",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Ryu-CZ/pi-dreamer.git"
  },
  "files": [
    "src/",
    "test/",
    "benchmark/",
    "scripts/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "description": "Evidence-linked forward capture and backward consolidation for Pi",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.js",
    "test:pi": "node test/pi-smoke.js",
    "benchmark": "node benchmark/run.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
